{
  "schema_version": "0.1.0",
  "project": "cuts-for-social_media",
  "repository_url": "https://github.com/elitt01/cuts-for-social_media",
  "audience": { "locale": "pt-BR", "region": "BR", "age_band": null },
  "niche_policy": {
    "mode": "adaptive_by_request_and_trends",
    "fixed_niche": null,
    "user_request_takes_priority": true,
    "open_requests_allow_cross_niche_discovery": true,
    "adapt_style_and_references_per_task": true
